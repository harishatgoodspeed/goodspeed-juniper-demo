{
  "name": "goodspeed-brand-os",
  "version": "0.1.0",
  "private": true,
  "description": "Goodspeed Brand OS: imports a real site's brand, drafts briefs, renders real assets, reviews them, and publishes a shareable result page.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "test": "node --env-file=.env.test --import tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "css-tree": "^2.3.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ipaddr.js": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/css-tree": "^2.3.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
