# Copy to .env and fill in. Never commit the real .env file.

# --- Server ---
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Storage ---
# On Railway, point this at the mounted persistent volume, e.g. /data/app.db
DATABASE_PATH=./data/app.db
# Where fetched/generated files are stored. Served only through controlled routes, never as static files.
ASSET_DIR=./data/assets

# --- Auth (required) ---
# Shared access code gating this private prototype. Generate a long random value.
APP_ACCESS_CODE=
# Secret used to sign session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Anthropic (required for Phase 2+: briefs and voice review) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Limits ---
MAX_CONCURRENT_JOBS=2
DAILY_RUN_LIMIT=20
MAX_RUN_TOKENS=20000
COLOUR_DELTA_E_THRESHOLD=4
RETENTION_DAYS=30

# --- Optional image generation provider (Phase 3+) ---
# IMAGE_PROVIDER=
# IMAGE_PROVIDER_API_KEY=
