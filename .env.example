# Copy to .env and fill in. Never commit the real .env file.

# --- Server ---
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# --- Storage ---
# On Railway, point this at the mounted persistent volume, e.g. /data/app.db
DATABASE_PATH=./data/app.db
# Where fetched/generated files are stored. Served only through controlled routes, never as static files.
ASSET_DIR=./data/assets

# --- Auth (required in production) ---
# No login step: every visitor gets an isolated, anonymous workspace
# automatically (see src/security/auth-middleware.ts). This secret signs
# that session cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Anthropic (required for brief generation, real copy/voice review) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Limits ---
MAX_CONCURRENT_JOBS=2
DAILY_RUN_LIMIT=20
MAX_RUN_TOKENS=20000
COLOUR_DELTA_E_THRESHOLD=4
LOGO_SIMILARITY_THRESHOLD=0.9
UPLOAD_COLOUR_MATCH_THRESHOLD=12
RETENTION_DAYS=30

# --- Free-tool spend caps (PLACEHOLDER — tune once real traffic/cost data exists) ---
PER_VISITOR_DAILY_SPEND_USD=2.0
GLOBAL_DAILY_SPEND_USD=50.0

# --- Optional: post-delivery lead capture notifications ---
# When set, a message is posted here every time a visitor submits the
# optional "want a call about the paid build" form.
# SLACK_WEBHOOK_URL=

# --- Optional image generation provider (not currently used) ---
# IMAGE_PROVIDER=
# IMAGE_PROVIDER_API_KEY=
